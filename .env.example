# socket-core definitivo — hub de transporte seguro multi-proyecto
PORT=3005
HOST=0.0.0.0
RUST_LOG=info

# SQLite (archivo local; en Docker va en volumen)
DATABASE_URL=sqlite:./data/socket-core.db?mode=rwc

# JWT corta vida (600s = 10min). ¡ROTAR en producción!
# Generar con: openssl rand -hex 64
JWT_SECRET=CHANGE-ME-openssl-rand-hex-64
JWT_TTL_SECS=600

# Admin de keys (solo backend, nunca al frontend)
# Generar con: openssl rand -hex 32
MASTER_KEY=CHANGE-ME-openssl-rand-hex-32

# CORS global (coma-separado). Vacío/* = permisivo solo dev.
# Ej: ALLOWED_ORIGINS=https://panel.midominio.com,https://app.midominio.com
ALLOWED_ORIGINS=

# Bootstrap dev: crea key inicial si DB vacía. En prod poner false tras crear keys reales.
ALLOW_BOOTSTRAP=true
