# socket-core — hub de transporte seguro multi-proyecto
# Arranque estricto: si JWT_SECRET es el valor por defecto o <32, MASTER_KEY <32,
# JWT_TTL_SECS fuera de [60,3600], o ALLOWED_ORIGINS falta en producción (APP_ENV!=dev),
# el proceso NO arranca.
PORT=3005
HOST=0.0.0.0
RUST_LOG=info

# Listener de administración (solo loopback dentro del contenedor; NO publicar).
ADMIN_PORT=3015

# SQLite (archivo local; en Docker va en volumen)
DATABASE_URL=sqlite:./data/socket-core.db?mode=rwc

# JWT corta vida (600s = 10min). ROTAR en producción.
# Generar con: openssl rand -hex 64   (>= 32 caracteres)
JWT_SECRET=CHANGE-ME-openssl-rand-hex-64
JWT_TTL_SECS=600

# Admin de keys (solo backend, nunca al frontend). >= 32 caracteres.
# Generar con: openssl rand -hex 32
MASTER_KEY=CHANGE-ME-openssl-rand-hex-32

# "prod" (default) exige ALLOWED_ORIGINS; "dev" permite CORS permisivo.
APP_ENV=prod
# Ej: ALLOWED_ORIGINS=https://panel.midominio.com,https://app.midominio.com
ALLOWED_ORIGINS=

# Bootstrap dev: por defecto false. Si true y la DB está vacía, escribe la key
# inicial en ./data/bootstrap-key.txt (0600); NUNCA se loguea en claro.
ALLOW_BOOTSTRAP=false

# Proxies de confianza para leer X-Forwarded-For / X-Real-IP (IPs o CIDR).
# Vacío = no se confía en cabeceras (se usa la IP del socket).
TRUSTED_PROXIES=

# Tiempo máximo total de apagado ordenado (segundos).
SHUTDOWN_GRACE_SECS=10
